# Server Configuration
PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Store Driver: "memory" (Checkpoint 1-2) or "prisma" (Checkpoint 3)
STORE_DRIVER=memory

# Database (Prisma / PostgreSQL - Checkpoint 3)
DATABASE_URL=postgresql://user:password@localhost:5432/lostfound?schema=public
DATABASE_URL_UNPOOLED=postgresql://user:password@localhost:5432/lostfound?schema=public

# Neon Cloud (Checkpoint 3)
NEON_BRANCH=production
NEON_BRANCH_ID=
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=

# Cloudinary (Checkpoint 3)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

